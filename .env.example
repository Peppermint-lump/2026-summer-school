# =============================================================================
# Cloud provider credentials (fill these values locally; never commit .env)
# =============================================================================

# MiMo-V2.5: canonical audio/video emotion provider.
# Pay-as-you-go endpoint; Token Plan users must replace it with the plan endpoint
# displayed by the MiMo console.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# Qwen3-Omni-Flash: fallback audio/video emotion provider.
# Replace the base URL with your workspace-specific endpoint when applicable.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-omni-flash

# GLM: text-only emotion analysis and companion response generation.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_TEXT_EMOTION_MODEL=glm-4.7-flash
GLM_COMPANION_MODEL=glm-4.7-flash

# =============================================================================
# Provider/model selection (non-secret)
# =============================================================================

VIDEO_EMOTION_ENABLED=false
TEXT_EMOTION_ENABLED=false
VIDEO_EMOTION_PROVIDER=mimo
AUDIO_EMOTION_PROVIDER=mimo
TEXT_EMOTION_PROVIDER=glm
COMPANION_PROVIDER=glm

# Open-LLM-VTuber consumes the GLM values above through environment substitution.
VTUBER_LLM_PROVIDER=zhipu_llm
LIVE2D_DEFAULT_MODEL=xiaohudie

# Local models do not require API keys.
ASR_MODEL=sherpa_onnx_asr
TTS_MODEL=piper_tts
XIAOHUDIE_TTS_MODEL_PATH=models/piper/zh_CN-huayan-medium.onnx
FELIX_TTS_MODEL_PATH=models/piper/zh_CN-chaowen-medium.onnx
